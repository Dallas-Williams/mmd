<script>
    // State Management
    const state = {
        currentView: 'games',
        data: {
            games: {
                title: "The Mirror & The Compass",
                badge: "Strategic Core",
                badgeColor: "bg-amber-100 text-amber-800",
                content: `
                    <p>MEA Games serves as the organizational "Mirror to Society." It is not just entertainment; it is a psychological funnel.</p>
                    <ul class="list-none space-y-3 pl-0 mt-4 text-sm">
                        <li class="flex items-start"><span class="mr-2 text-amber-500 text-lg">â¤</span><span><strong>Attract:</strong> Uses the "Mirror Metaphor" and narratives like "Three stars rise..." to engage users in self-reflection.</span></li>
                        <li class="flex items-start"><span class="mr-2 text-amber-500 text-lg">â¤</span><span><strong>Direct:</strong> Acts as a compass, guiding users to either the Academy (Research) or Alliance (Action).</span></li>
                        <li class="flex items-start"><span class="mr-2 text-amber-500 text-lg">â¤</span><span><strong>Impact:</strong> Turns abstract play into concrete progress for veterans and society.</span></li>
                    </ul>
                    <div class="mt-6 p-4 bg-amber-50 border border-amber-100 rounded text-xs text-stone-500">
                        <strong>Key Mechanism:</strong> The game measures "pressure internalized" and "expelled eruption" to categorize player potential.
                    </div>
                `,
                chartType: 'line',
                chartTitle: 'Engagement Flow',
                chartLabel: 'User Volume',
                chartLabels: ['Awareness', 'Play', 'Reflection', 'Action'],
                chartData: [100, 85, 60, 40],
                chartColor: '#f59e0b'
            },
            academy: {
                title: "Meta Ethics Academy",
                badge: "Pillar One: Internal",
                badgeColor: "bg-violet-100 text-violet-800",
                content: `
                    <p>The Academy simulates societal dynamics to study human nature, biases, and social engineering techniques. It is the theoretical engine of the ecosystem.</p>
                    <h5 class="font-bold mt-4 mb-2 text-violet-700">Key Activities:</h5>
                    <ul class="list-none space-y-2 pl-0 text-sm">
                        <li class="flex items-center"><span class="mr-2">ð¬</span> Immersive Workshops & Role-Playing</li>
                        <li class="flex items-center"><span class="mr-2">ð</span> Hierarchy Tests & Bias Loops</li>
                        <li class="flex items-center"><span class="mr-2">ð¤</span> Echo Chamber Simulations</li>
                    </ul>
                    <div class="mt-6 p-4 bg-violet-50 border border-violet-100 rounded text-xs text-stone-500">
                        <strong>Expansion Idea:</strong> VR simulations and university partnerships to publish findings on social nudges.
                    </div>
                `,
                chartType: 'radar',
                chartTitle: 'Simulation Focus Areas',
                chartLabel: 'Intensity',
                chartLabels: ['Hierarchy', 'Bias', 'Loyalty', 'Ethics', 'Consent'],
                chartData: [90, 85, 75, 95, 80],
                chartColor: '#7c3aed'
            },
            alliance: {
                title: "Mission Equity Alliance",
                badge: "Pillar Two: External",
                badgeColor: "bg-cyan-100 text-cyan-800",
                content: `
                    <p>The Alliance provides "Second Chances" and entry resources. It focuses on tangible support for veterans and marginalized communities, translating the Academy's findings into policy.</p>
                    <h5 class="font-bold mt-4 mb-2 text-cyan-700">Core Services:</h5>
                    <ul class="list-none space-y-2 pl-0 text-sm">
                        <li class="flex items-center"><span class="mr-2">ð</span> Eligibility Verification</li>
                        <li class="flex items-center"><span class="mr-2">ð¤</span> Resource Access & Advocacy</li>
                        <li class="flex items-center"><span class="mr-2">ðï¸</span> VA/Government Partnerships</li>
                    </ul>
                    <div class="mt-6 p-4 bg-cyan-50 border border-cyan-100 rounded text-xs text-stone-500">
                        <strong>Legal Structure:</strong> 501(c)(3) tax-exempt organization ensuring no private profits.
                    </div>
                `,
                chartType: 'bar',
                chartTitle: 'Resource Allocation',
                chartLabel: 'Effort Distribution',
                chartLabels: ['Advocacy', 'Verification', 'Events', 'Workshops'],
                chartData: [35, 30, 15, 20],
                chartColor: '#0891b2'
            }
        }
    };

    // Chart Instances
    let mainDynamicChart = null;
    let academyChart = null;
    let allianceChart = null;

    // Initialization
    document.addEventListener('DOMContentLoaded', () => {
        initMainChart();
        initDeepDiveCharts();
    });

    // Function to update the view based on selection
    function updateView(viewName) {
        state.currentView = viewName;
        const data = state.data[viewName];

        // Update Cards Styling
        document.querySelectorAll('.interactive-card').forEach(el => {
            el.classList.remove('active-card', 'ring-4', 'ring-stone-100', 'transform', 'scale-105');
            el.classList.add('opacity-75'); // Dim others
        });
        const activeCard = document.getElementById(`card-${viewName}`);
        activeCard.classList.add('active-card', 'ring-4', 'ring-stone-100', 'transform', 'scale-105');
        activeCard.classList.remove('opacity-75');

        // Update Content Panel with animation
        const section = document.getElementById('detail-section');
        section.classList.add('opacity-50', 'scale-95');
        
        setTimeout(() => {
            // Text Updates
            document.getElementById('detail-title').innerText = data.title;
            document.getElementById('detail-badge').innerText = data.badge;
            document.getElementById('detail-badge').className = `inline-block px-3 py-1 rounded-full text-xs font-bold uppercase mb-3 ${data.badgeColor}`;
            document.getElementById('detail-content').innerHTML = data.content;
            document.getElementById('chart-title').innerText = data.chartTitle;

            // Chart Update
            updateMainChart(viewName);

            section.classList.remove('opacity-50', 'scale-95');
        }, 300);
    }

    // Main Dynamic Chart Logic (Chart.js)
    function initMainChart() {
        const ctx = document.getElementById('dynamicChart').getContext('2d');
        const initialData = state.data.games;

        mainDynamicChart = new Chart(ctx, {
            type: initialData.chartType,
            data: {
                labels: initialData.chartLabels,
                datasets: [{
                    label: initialData.chartLabel,
                    data: initialData.chartData,
                    borderColor: initialData.chartColor,
                    backgroundColor: initialData.chartColor + '33', // Add transparency
                    borderWidth: 2,
                    fill: true,
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#fff',
                        titleColor: '#1c1917',
                        bodyColor: '#57534e',
                        borderColor: '#e7e5e4',
                        borderWidth: 1,
                        callbacks: {
                            label: function(context) {
                                return context.parsed.y + (state.currentView === 'games' ? '%' : '');
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { display: true, color: '#f5f5f4' },
                        ticks: { display: false }
                    },
                    x: {
                        grid: { display: false }
                    }
                }
            }
        });
    }

    function updateMainChart(viewName) {
        const data = state.data[viewName];
        
        mainDynamicChart.config.type = data.chartType;
        mainDynamicChart.data.labels = data.chartLabels;
        mainDynamicChart.data.datasets[0].label = data.chartLabel;
        mainDynamicChart.data.datasets[0].data = data.chartData;
        mainDynamicChart.data.datasets[0].borderColor = data.chartColor;
        mainDynamicChart.data.datasets[0].backgroundColor = data.chartColor + '33';
        
        mainDynamicChart.update();
    }

    // Deep Dive Charts (Static Charts for Bottom Section)
    function initDeepDiveCharts() {
        // Academy Radar Chart
        const ctxAcademy = document.getElementById('academyChart').getContext('2d');
        academyChart = new Chart(ctxAcademy, {
            type: 'radar',
            data: {
                labels: ['Hierarchy Tests', 'Bias Loops', 'Loyalty Games', 'Ethical Debates', 'Data Collection'],
                datasets: [{
                    label: 'Simulation Intensity',
                    data: [85, 70, 60, 90, 95],
                    backgroundColor: 'rgba(124, 58, 237, 0.2)', // Violet
                    borderColor: '#7c3aed',
                    pointBackgroundColor: '#7c3aed'
                }, {
                    label: 'Risk Factor',
                    data: [60, 80, 50, 20, 70],
                    backgroundColor: 'rgba(168, 162, 158, 0.2)', // Stone
                    borderColor: '#a8a29e',
                    pointBackgroundColor: '#a8a29e',
                    borderDash: [5, 5]
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    r: {
                        angleLines: { color: '#f5f5f4' },
                        grid: { color: '#f5f5f4' },
                        pointLabels: { font: { size: 10 } }
                    }
                },
                plugins: {
                    legend: { position: 'bottom', labels: { boxWidth: 10 } }
                }
            }
        });

        // Alliance Doughnut Chart
        const ctxAlliance = document.getElementById('allianceChart').getContext('2d');
        allianceChart = new Chart(ctxAlliance, {
            type: 'doughnut',
            data: {
                labels: ['Eligibility Checks', 'Resource Access', 'Advocacy', 'Workshops'],
                datasets: [{
                    data: [40, 30, 20, 10],
                    backgroundColor: [
                        '#0891b2', // Cyan-600
                        '#22d3ee', // Cyan-400
                        '#67e8f9', // Cyan-300
                        '#cffafe'  // Cyan-100
                    ],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'right', labels: { boxWidth: 10, font: { size: 11 } } }
                },
                cutout: '70%'
            }
        });
    }
</script>

